# Copy to .env and fill in. Never commit .env.
TELEGRAM_BOT_TOKEN=          # From @BotFather
WEBHOOK_URL=                 # e.g. https://sika-track.onrender.com (leave empty for local polling)
WEBHOOK_SECRET=              # Random string; same value on Render
CRON_SECRET=                 # Random string; used in the daily-summary cron URL
DATABASE_URL=                # Supabase Postgres URL (leave empty for local SQLite)
